---
import '../styles/global.css';
import TermTooltipScript from './TermTooltipScript.astro';
interface Props {
  title: string;
  description?: string;
}
const { title, description = '디시·해외 AI 커뮤니티 하루 동향 브리핑' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <h1><a href={import.meta.env.BASE_URL}>디시 AI 동향 브리핑</a></h1>
        <p>디시 AI 갤 + 해외 커뮤니티 · 매일 업데이트</p>
      </header>
      <slot />
      <footer class="site">무료 정적 호스팅 · 본문 속 점선 용어는 클릭하면 설명이 나옵니다.</footer>
    </div>
    <TermTooltipScript />
  </body>
</html>
