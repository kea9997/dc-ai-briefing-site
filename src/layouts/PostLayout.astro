---
import BaseLayout from '../components/BaseLayout.astro';
import { renderTerms } from '../components/renderTerms';

interface Props {
  title: string;
  description: string;
  date: Date;
  content: string;
}
const { title, description, date, content } = Astro.props;
const dateLabel = date.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Seoul',
});
const html = renderTerms(content);
---
<BaseLayout title={title} description={description}>
  <a class="back" href={import.meta.env.BASE_URL}>← 목록</a>
  <article class="post">
    <h1>{title}</h1>
    <p class="meta">{dateLabel}</p>
    <div set:html={html} />
  </article>
</BaseLayout>
