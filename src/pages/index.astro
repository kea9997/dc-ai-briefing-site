---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import { SITE } from '../lib/site';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type DayGroup = {
  dateKey: string;
  date: Date;
  beginner?: (typeof posts)[number];
  advanced?: (typeof posts)[number];
};

const byDate = new Map<string, DayGroup>();
for (const post of posts) {
  const dateKey = post.data.date.toISOString().slice(0, 10);
  let g = byDate.get(dateKey);
  if (!g) {
    g = { dateKey, date: post.data.date };
    byDate.set(dateKey, g);
  }
  if (post.data.level === 'beginner') g.beginner = post;
  else g.advanced = post;
}
const days = Array.from(byDate.values()).sort(
  (a, b) => b.date.valueOf() - a.date.valueOf()
);
const latest = days[0];
const versionCount = posts.length;
---
<BaseLayout title={SITE.name} description={SITE.description} type="website">
  <section class="hero">
    <div class="eyebrow">Daily AI Community Briefing</div>
    <h1>국내와 해외 AI 커뮤니티,<br />하루에 한 번 신호만 모읍니다.</h1>
    <p>
      {SITE.name}는 국내 AI 커뮤니티의 개념글·고조회와 Reddit·Hacker News 등 해외 논의를
      교차 확인해, 안 읽어도 오늘 판이 보이게 한국어로 정리합니다. 매일 <strong>초보</strong>와
      <strong>고급</strong> 두 버전을 함께 발행합니다.
    </p>
    <div class="hero-meta">
      <span class="chip">국내 우선</span>
      <span class="chip">해외 교차</span>
      <span class="chip">초보 · 고급</span>
      <span class="chip">확인/루머 구분</span>
      <span class="chip">용어 클릭 설명</span>
    </div>
  </section>

  {latest && (
    <p class="prose-note">최신: {latest.date.toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul' })} · {days.length}일 · {versionCount}버전</p>
  )}

  <section class="card-list" aria-label="브리핑 목록">
    {days.length === 0 ? (
      <p>아직 발행된 브리핑이 없습니다.</p>
    ) : (
      days.map((day) => {
        const dateLabel = day.date.toLocaleDateString('ko-KR', {
          year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul',
        });
        const hookTitle =
          day.beginner?.data.title ||
          day.advanced?.data.title ||
          `${dateLabel} 브리핑`;
        const desc =
          day.beginner?.data.description ||
          day.advanced?.data.description ||
          '';
        return (
          <div class="card day-card">
            <div class="meta">{dateLabel} · 초보 · 고급</div>
            <h2>{hookTitle}</h2>
            {day.advanced && day.beginner && day.advanced.data.title !== day.beginner.data.title && (
              <p class="day-advanced-hook"><span class="level-badge level-advanced">고급</span> {day.advanced.data.title}</p>
            )}
            <p>{desc}</p>
            <div class="day-links">
              {day.beginner && (
                <a class="level-link level-beginner" href={`/posts/${day.beginner.id}/`}>
                  <span class="level-badge level-beginner">초보</span>
                  읽기
                </a>
              )}
              {day.advanced && (
                <a class="level-link level-advanced" href={`/posts/${day.advanced.id}/`}>
                  <span class="level-badge level-advanced">고급</span>
                  읽기
                </a>
              )}
            </div>
          </div>
        );
      })
    )}
  </section>
</BaseLayout>
