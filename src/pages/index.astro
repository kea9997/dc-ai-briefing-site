---
import BaseLayout from '../components/BaseLayout.astro';
import { SITE } from '../lib/site';
import { getPublishedPosts, groupPostsByDay, formatDateKo } from '../lib/posts';

const posts = await getPublishedPosts();
const days = groupPostsByDay(posts);
const latest = days[0];
const pastDays = days.slice(1);
const versionCount = posts.length;
---
<BaseLayout title={SITE.name} description={SITE.description} type="website">
  <section class="hero">
    <div class="eyebrow">Daily AI Community Briefing</div>
    <h1>국내와 해외 AI 커뮤니티,<br />하루에 한 번 신호만 모읍니다.</h1>
    <p>
      {SITE.name}는 국내 AI 커뮤니티의 개념글·고조회와 Reddit·Hacker News 등 해외 논의를
      교차 확인해, 안 읽어도 오늘 판이 보이게 한국어로 정리합니다. 매일 <strong>초보</strong>와
      <strong>고급</strong> 두 버전을 함께 발행합니다.
    </p>
    <div class="hero-meta">
      <span class="chip">국내 우선</span>
      <span class="chip">해외 교차</span>
      <span class="chip">초보 · 고급</span>
      <span class="chip">확인/루머 구분</span>
      <span class="chip">용어 클릭 설명</span>
    </div>
    <div class="hero-telegram">
      <a class="btn-telegram" href={SITE.telegram.url} target="_blank" rel="noopener noreferrer">
        텔레그램으로 매일 받기
      </a>
      {latest && (
        <a class="hero-today-link" href="#today">오늘 브리핑 보기</a>
      )}
    </div>
  </section>

  {latest && (
    <section class="today-panel" id="today" aria-label="오늘의 브리핑">
      <div class="today-panel-meta">
        <span class="today-chip">오늘</span>
        <span class="meta">{formatDateKo(latest.date)}</span>
      </div>
      <h2 class="today-panel-title">
        {latest.beginner?.data.title || latest.advanced?.data.title || `${formatDateKo(latest.date)} 브리핑`}
      </h2>
      {(latest.beginner?.data.description || latest.advanced?.data.description) && (
        <p class="today-panel-desc">
          {latest.beginner?.data.description || latest.advanced?.data.description}
        </p>
      )}
      <div class="today-panel-actions">
        {latest.beginner && (
          <a class="btn-read btn-read-solid" href={`/posts/${latest.beginner.id}/`}>초보 읽기</a>
        )}
        {latest.advanced && (
          <a class="btn-read btn-read-outline" href={`/posts/${latest.advanced.id}/`}>고급 읽기</a>
        )}
      </div>
      <div class="today-panel-secondary">
        <a class="btn-telegram" href={SITE.telegram.url} target="_blank" rel="noopener noreferrer">
          텔레그램으로 매일 받기
        </a>
      </div>
    </section>
  )}

  {latest && (
    <p class="prose-note">최신: {formatDateKo(latest.date)} · {days.length}일 · {versionCount}버전</p>
  )}

  <section class="card-list" aria-label="지난 브리핑">
    {days.length === 0 ? (
      <p>아직 발행된 브리핑이 없습니다.</p>
    ) : pastDays.length === 0 ? (
      <p class="prose-note">지난 브리핑이 아직 없습니다. 위에서 오늘 브리핑을 읽어 보세요.</p>
    ) : (
      <>
        <h2 class="section-heading">지난 브리핑</h2>
        {pastDays.map((day) => {
          const dateLabel = formatDateKo(day.date);
          const hookTitle =
            day.beginner?.data.title ||
            day.advanced?.data.title ||
            `${dateLabel} 브리핑`;
          const desc =
            day.beginner?.data.description ||
            day.advanced?.data.description ||
            '';
          return (
            <div class="card day-card">
              <div class="meta">{dateLabel} · 초보 · 고급</div>
              <h2>{hookTitle}</h2>
              {day.advanced && day.beginner && day.advanced.data.title !== day.beginner.data.title && (
                <p class="day-advanced-hook"><span class="level-badge level-advanced">고급</span> {day.advanced.data.title}</p>
              )}
              <p>{desc}</p>
              <div class="day-links">
                {day.beginner && (
                  <a class="level-link level-beginner" href={`/posts/${day.beginner.id}/`}>
                    <span class="level-badge level-beginner">초보</span>
                    읽기
                  </a>
                )}
                {day.advanced && (
                  <a class="level-link level-advanced" href={`/posts/${day.advanced.id}/`}>
                    <span class="level-badge level-advanced">고급</span>
                    읽기
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </>
    )}
  </section>

  <section class="stay-strip stay-strip-card" aria-label="구독·다시 찾기">
    <div class="stay-strip-copy">
      <h2 class="stay-strip-title">놓치기 싫다면</h2>
      <p class="stay-strip-lead">아침마다 같은 브리핑을 텔레그램·RSS로 보냅니다.</p>
    </div>
    <div class="stay-strip-links">
      <a href={SITE.telegram.url} target="_blank" rel="noopener noreferrer">텔레그램</a>
      <a href="/rss.xml">RSS</a>
      <a href="/archive/">아카이브</a>
      <a href="/topics/">주제</a>
      <a href="/weekly/">주간</a>
    </div>
  </section>
</BaseLayout>
