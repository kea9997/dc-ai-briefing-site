---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import ShareBar from '../../components/ShareBar.astro';
import { renderTerms } from '../../components/renderTerms';
import { marked } from 'marked';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const dateLabel = post.data.date.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul',
});
const iso = post.data.date.toISOString();
const md = post.body ?? '';
const html = renderTerms(await marked.parse(md));

const level = post.data.level;
const levelKo = level === 'beginner' ? '초보' : '고급';
const siblingLevel = level === 'beginner' ? 'advanced' : 'beginner';
const siblingKo = level === 'beginner' ? '고급' : '초보';
const dateId = post.data.date.toISOString().slice(0, 10);
const siblingHref = `/posts/${dateId}/${siblingLevel}/`;
const pageUrl = `${SITE.domain}/posts/${post.id}/`;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.data.title,
  description: post.data.description,
  datePublished: iso,
  dateModified: iso,
  inLanguage: 'ko-KR',
  mainEntityOfPage: pageUrl,
  author: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
  publisher: {
    '@type': 'Organization',
    name: SITE.parent.name,
    url: SITE.parent.url,
  },
  isAccessibleForFree: true,
};
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  datePublished={iso}
  dateModified={iso}
  jsonLd={articleLd}
>
  <a class="back" href="/">← 목록</a>
  <article class="post">
    <div class="post-level-row">
      <span class={`level-badge level-${level}`}>{levelKo}</span>
      <a class="sibling-link" href={siblingHref}>같은 날 {siblingKo} 버전 보기 →</a>
    </div>
    <h1>{post.data.title}</h1>
    <p class="meta">{dateLabel} · {SITE.name} · {levelKo}</p>
    <ShareBar title={post.data.title} pageUrl={pageUrl} placement="top" />
    <div class="tldr">
      <strong>한 줄 요약 (GEO)</strong>
      {post.data.description}
    </div>
    <div set:html={html} />
    <ShareBar title={post.data.title} pageUrl={pageUrl} placement="bottom" />
    <div class="post-end-cta">
      <p class="post-end-cta-label">내일 아침에도 보려면</p>
      <a class="btn-telegram" href={SITE.telegram.url} target="_blank" rel="noopener noreferrer">
        텔레그램으로 매일 받기
      </a>
    </div>
  </article>
</BaseLayout>

<script is:inline>
  (function () {
    function wireShareBars() {
      document.querySelectorAll('[data-share-url]').forEach(function (bar) {
        if (bar.dataset.wired === '1') return;
        bar.dataset.wired = '1';

        var live = bar.querySelector('[data-share-live]');
        var copyBtn = bar.querySelector('[data-copy-link]');
        var nativeBtn = bar.querySelector('[data-native-share]');
        var url = bar.dataset.shareUrl || window.location.href;
        var title = bar.dataset.shareTitle || document.title;

        if (nativeBtn && typeof navigator.share === 'function') {
          nativeBtn.hidden = false;
          nativeBtn.addEventListener('click', function () {
            navigator.share({ title: title, url: url, text: title }).catch(function () {});
          });
        }

        if (copyBtn) {
          copyBtn.addEventListener('click', async function () {
            var label = copyBtn.textContent;
            try {
              await navigator.clipboard.writeText(url);
              copyBtn.textContent = '복사됨';
              if (live) live.textContent = '링크가 복사되었습니다';
            } catch (e) {
              copyBtn.textContent = '복사 실패';
              if (live) live.textContent = '복사에 실패했습니다';
            }
            window.setTimeout(function () {
              copyBtn.textContent = label || '링크 복사';
              if (live) live.textContent = '';
            }, 1600);
          });
        }
      });
    }
    wireShareBars();
  })();
</script>
