---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import { renderTerms } from '../../components/renderTerms';
import { marked } from 'marked';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const dateLabel = post.data.date.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul',
});
const iso = post.data.date.toISOString();
const md = post.body ?? '';
const html = renderTerms(await marked.parse(md));

const level = post.data.level;
const levelKo = level === 'beginner' ? '초보' : '고급';
const siblingLevel = level === 'beginner' ? 'advanced' : 'beginner';
const siblingKo = level === 'beginner' ? '고급' : '초보';
const dateId = post.data.date.toISOString().slice(0, 10);
const siblingHref = `/posts/${dateId}/${siblingLevel}/`;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.data.title,
  description: post.data.description,
  datePublished: iso,
  dateModified: iso,
  inLanguage: 'ko-KR',
  mainEntityOfPage: `${SITE.domain}/posts/${post.id}/`,
  author: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
  publisher: {
    '@type': 'Organization',
    name: SITE.parent.name,
    url: SITE.parent.url,
  },
  isAccessibleForFree: true,
};
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  datePublished={iso}
  dateModified={iso}
  jsonLd={articleLd}
>
  <a class="back" href="/">← 목록</a>
  <article class="post">
    <div class="post-level-row">
      <span class={`level-badge level-${level}`}>{levelKo}</span>
      <a class="sibling-link" href={siblingHref}>같은 날 {siblingKo} 버전 보기 →</a>
    </div>
    <h1>{post.data.title}</h1>
    <p class="meta">{dateLabel} · {SITE.name} · {levelKo}</p>
    <div class="tldr">
      <strong>한 줄 요약 (GEO)</strong>
      {post.data.description}
    </div>
    <div set:html={html} />
  </article>
</BaseLayout>
