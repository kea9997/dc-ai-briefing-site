---
import BaseLayout from '../../components/BaseLayout.astro';
import { SITE } from '../../lib/site';
import {
  TOPICS,
  getPublishedPosts,
  filterPostsByTopic,
  formatDateKo,
} from '../../lib/posts';

export function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}

const { topic } = Astro.props;
const posts = await getPublishedPosts();
const matched = filterPostsByTopic(posts, topic);

const intros: Record<string, string[]> = {
  quota: [
    '구독료는 그대로인데 한 주 쓸 수 있는 양이 줄어든다는 이야기, API·채팅·에이전트마다 닳는 속도가 다르다는 이야기가 자주 올라옵니다.',
    '국내·해외 커뮤니티는 공식 공지보다 체감 숫자·역산표·Inference Gap 같은 말로 먼저 반응합니다. 매일 브리핑은 그 신호를 모아 확인/미확인을 붙입니다.',
    '아래는 제목·요약·태그에 한도·쿼터·예산 관련 키워드가 잡힌 날들입니다. 최신 해석은 각 날의 초보·고급 글을 보세요.',
  ],
  'local-llm': [
    '클라우드 한도가 빡빡해질수록, 로컬에서 돌리거나 로컬로 라우팅하자는 말이 같이 커집니다.',
    'LocalLLaMA·온디바이스·VRAM·로컬 라우팅 같은 축이 해외에서 먼저 뜨고, 국내 판에서도 운영 팁으로 이어지는 날이 있습니다.',
    '여기 목록은 그날 브리핑이 로컬 LLM 신호를 다룬 날입니다. 하드웨어 고르기는 Optiwork의 로컬 LLM GPU 픽커도 참고할 수 있습니다.',
  ],
  'model-launch': [
    '새 모델 이름과 토큰 단가, DevDay·릴리스 소식이 같은 아침에 겹치는 날이 있습니다.',
    '커뮤니티는 발표 문장보다 “채팅창에 열렸는지”, “작업당 토큰이 얼마나 먹는지”를 먼저 셉니다. 브리핑도 그 간격을 적습니다.',
    '아래는 출시·가격·단가 키워드가 제목·요약·태그에 잡힌 글입니다.',
  ],
};

const paragraphs = intros[topic.slug] ?? [
  `${topic.title} 관련 신호를 매일 브리핑에서 모아 둔 페이지입니다.`,
];
---
<BaseLayout
  title={`${topic.title} · ${SITE.name}`}
  description={`${SITE.name} · ${topic.title} — ${topic.short}`}
>
  <a class="back" href="/topics/">← 주제 목록</a>
  <article class="post">
    <h1>{topic.title}</h1>
    <p class="meta">{SITE.name} 주제 허브 · {matched.length}일</p>
    {paragraphs.map((p) => <p>{p}</p>)}

    <h2>관련 브리핑</h2>
    {matched.length === 0 ? (
      <p>아직 매칭된 글이 없습니다. 이후 발행분에서 채워집니다.</p>
    ) : (
      <ul class="topic-post-list">
        {matched.map((post) => (
          <li>
            <a href={`/posts/${post.id}/`}>
              <span class="meta">{formatDateKo(post.data.date)} · {post.data.level === 'beginner' ? '초보' : '고급'}</span>
              <strong>{post.data.title}</strong>
              <span class="topic-post-desc">{post.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <p class="prose-note" style="margin-top:1.5rem">
      전체 날짜는 <a href="/archive/">아카이브</a> · 구독은
      <a href={SITE.telegram.url} target="_blank" rel="noopener noreferrer">텔레그램</a>
      · <a href="/rss.xml">RSS</a>
    </p>
  </article>
</BaseLayout>
